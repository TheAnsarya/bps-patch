# ============================================================================
# BPS Patch - Editor Configuration
# ============================================================================
# This file defines consistent coding styles across all editors and IDEs.
# See: https://editorconfig.org
# ============================================================================

root = true

# ============================================================================
# Default Settings - ALL FILES USE TABS
# ============================================================================
[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
tab_width = 4

# ============================================================================
# C# Source Files
# ============================================================================
[*.cs]
indent_style = tab
tab_width = 4
charset = utf-8
end_of_line = crlf

# Brace placement - K&R style (same line)
csharp_new_line_before_open_brace = none
csharp_new_line_before_else = false
csharp_new_line_before_catch = false
csharp_new_line_before_finally = false

# Modern C# preferences
csharp_prefer_simple_using_statement = true
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning
csharp_style_expression_bodied_methods = false:silent
csharp_style_expression_bodied_properties = true:warning
csharp_style_expression_bodied_indexers = true:warning
csharp_style_expression_bodied_accessors = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_prefer_switch_expression = true:suggestion
csharp_prefer_pattern_matching = true:suggestion
csharp_style_prefer_not_pattern = true:suggestion
dotnet_style_prefer_collection_expression = true:suggestion

# Use var
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = true:suggestion

# XML documentation - suppress missing doc warnings
dotnet_diagnostic.CS1591.severity = none

# Code analysis suppressions
dotnet_diagnostic.CA1303.severity = none
dotnet_diagnostic.CA2022.severity = none

# ============================================================================
# PowerShell Scripts
# ============================================================================
[*.ps1]
indent_style = tab
tab_width = 4
charset = utf-8
end_of_line = crlf

[*.psm1]
indent_style = tab
tab_width = 4

[*.psd1]
indent_style = tab
tab_width = 4

# ============================================================================
# Shell Scripts
# ============================================================================
[*.sh]
indent_style = tab
tab_width = 4
end_of_line = lf

[*.bash]
indent_style = tab
tab_width = 4
end_of_line = lf

# ============================================================================
# Project & Build Files
# ============================================================================
[*.{csproj,vbproj,vcxproj,vcxproj.filters,proj,projitems,shproj}]
indent_style = tab
tab_width = 2

[*.props]
indent_style = tab
tab_width = 2

[*.targets]
indent_style = tab
tab_width = 2

[*.sln]
indent_style = tab
tab_width = 4

# ============================================================================
# Configuration Files
# ============================================================================
[*.json]
indent_style = tab
tab_width = 2

[*.xml]
indent_style = tab
tab_width = 2

[*.yml]
indent_style = tab
tab_width = 2

[*.yaml]
indent_style = tab
tab_width = 2

# ============================================================================
# Markdown Documentation
# ============================================================================
[*.md]
indent_style = tab
tab_width = 4
trim_trailing_whitespace = false

# ============================================================================
# Web Files
# ============================================================================
[*.{html,htm}]
indent_style = tab
tab_width = 4

[*.css]
indent_style = tab
tab_width = 4

[*.{js,jsx,ts,tsx}]
indent_style = tab
tab_width = 4

# ============================================================================
# Config Files (specific)
# ============================================================================
[.gitignore]
indent_style = tab
tab_width = 4

[.gitattributes]
indent_style = tab
tab_width = 4

[Makefile]
indent_style = tab
tab_width = 4

[*.{bat,cmd}]
indent_style = tab
tab_width = 4
