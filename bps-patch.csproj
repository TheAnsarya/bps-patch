<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Version>1.0.0</Version>
		<RootNamespace>bps_patch</RootNamespace>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<EnablePreviewFeatures>false</EnablePreviewFeatures>
	</PropertyGroup>

	<ItemGroup>
		<!-- Exclude all subfolders - this is the legacy root project -->
		<Compile Remove="bps-patch.Tests\**" />
		<EmbeddedResource Remove="bps-patch.Tests\**" />
		<None Remove="bps-patch.Tests\**" />
		<Compile Remove="bps-patch.Benchmarks\**" />
		<EmbeddedResource Remove="bps-patch.Benchmarks\**" />
		<None Remove="bps-patch.Benchmarks\**" />
		<Compile Remove="src\**" />
		<EmbeddedResource Remove="src\**" />
		<None Remove="src\**" />
		<Compile Remove="legacy\**" />
		<EmbeddedResource Remove="legacy\**" />
		<None Remove="legacy\**" />
	</ItemGroup>

	<!-- Include legacy files for the root project to compile -->
	<ItemGroup>
		<Compile Include="legacy\*.cs" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="bps-patch.Tests" />
		<InternalsVisibleTo Include="bps-patch.Benchmarks" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="System.IO.Hashing" Version="9.0.0" />
	</ItemGroup>

</Project>
